# ========================================================
# Meme 代币 / NFT 舆情异动预警系统 - 环境变量配置
# 复制为 .env 并填入您的配置
# ========================================================

# 监控公链 (DexScreener 链标识，逗号分隔)
MONITOR_CHAINS=solana,bsc,base

# 轮询间隔 (秒) 与去重冷却时间 (分钟)
POLL_INTERVAL_SECONDS=180
DEDUP_COOLDOWN_MINUTES=45

# 链上 Meme 告警阈值
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_5M_USD=10000
MIN_PRICE_CHANGE_5M=15.0
MIN_BUYS_5M=20
MIN_BUY_SELL_RATIO=1.5

# 飞书机器人配置 (推荐 App-Bot 模式)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_CHAT_ID=oc_68dbbe5b348f3d561040a34e683d94f2

# 飞书自定义机器人 Webhook (可选备用)
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
